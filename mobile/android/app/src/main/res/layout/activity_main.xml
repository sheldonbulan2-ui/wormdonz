<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">

                <View
                    android:id="@+id/viewHeaderStatusDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_status_dot_inactive" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JARVIS-X OS CORE"
                        android:textColor="@color/jarvis_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Autonomous Android Operating System Assistant"
                        android:textColor="@color/jarvis_cyan"
                        android:textSize="12sp"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>

            <!-- MASTER SERVICE CONTROL CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTONOMOUS SERVICE"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Always-on voice recognition, floating cybernetic HUD orb, and screen control loop."
                    android:textColor="@color/jarvis_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleVoiceService"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="START JARVIS-X SERVICE"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    app:backgroundTint="@color/jarvis_cyan"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- API VAULT CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DYNAMIC IN-APP API VAULT (BYOK)"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stored locally using Android Keystore EncryptedSharedPreferences. Zero hardcoded keys."
                    android:textColor="@color/jarvis_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <!-- API Key -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Gemini / OpenAI API Key"
                    app:boxBackgroundColor="#0A101D"
                    app:boxStrokeColor="@color/jarvis_cyan"
                    app:hintTextColor="@color/jarvis_cyan"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/jarvis_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/jarvis_text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Provider URL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Provider Base URL"
                    app:boxBackgroundColor="#0A101D"
                    app:boxStrokeColor="@color/jarvis_cyan"
                    app:hintTextColor="@color/jarvis_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProviderUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="@color/jarvis_text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Model Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Model Name (e.g. gemini-2.5-flash)"
                    app:boxBackgroundColor="#0A101D"
                    app:boxStrokeColor="@color/jarvis_cyan"
                    app:hintTextColor="@color/jarvis_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etModelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/jarvis_text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Wake Word -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Voice Wake Word"
                    app:boxBackgroundColor="#0A101D"
                    app:boxStrokeColor="@color/jarvis_cyan"
                    app:hintTextColor="@color/jarvis_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWakeWord"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/jarvis_text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestPing"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="PING LLM"
                        android:textColor="@color/jarvis_cyan"
                        android:textStyle="bold"
                        app:strokeColor="@color/jarvis_cyan"
                        app:strokeWidth="1dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveConfig"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="SAVE CONFIG"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="@color/jarvis_blue" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPingResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="@color/jarvis_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- PERMISSION MATRIX CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OS PERMISSION CONTROL MATRIX"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="14dp" />

                <!-- 1. Accessibility Service -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/dotAccessibility"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_status_dot_inactive" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accessibility Service"
                            android:textColor="@color/jarvis_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Read screen &amp; automate gestures"
                            android:textColor="@color/jarvis_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GRANT"
                        android:textSize="11sp"
                        android:textColor="@color/jarvis_cyan"
                        app:strokeColor="@color/jarvis_cyan"
                        app:strokeWidth="1dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

                <!-- 2. Notification Listener -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/dotNotification"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_status_dot_inactive" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notification Listener"
                            android:textColor="@color/jarvis_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Intercept messages &amp; auto-reply"
                            android:textColor="@color/jarvis_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GRANT"
                        android:textSize="11sp"
                        android:textColor="@color/jarvis_cyan"
                        app:strokeColor="@color/jarvis_cyan"
                        app:strokeWidth="1dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

                <!-- 3. System Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/dotOverlay"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_status_dot_inactive" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Draw Over Other Apps"
                            android:textColor="@color/jarvis_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Floating cybernetic HUD orb"
                            android:textColor="@color/jarvis_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GRANT"
                        android:textSize="11sp"
                        android:textColor="@color/jarvis_cyan"
                        app:strokeColor="@color/jarvis_cyan"
                        app:strokeWidth="1dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

                <!-- 4. Runtime Permissions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/dotRuntime"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_status_dot_inactive" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hardware &amp; System Permissions"
                            android:textColor="@color/jarvis_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mic, Phone, SMS, Contacts, Flashlight"
                            android:textColor="@color/jarvis_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantRuntime"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GRANT"
                        android:textSize="11sp"
                        android:textColor="@color/jarvis_cyan"
                        app:strokeColor="@color/jarvis_cyan"
                        app:strokeWidth="1dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- LIVE TERMINAL CONSOLE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_terminal"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SYSTEM TELEMETRY &amp; AGENT LOGS"
                        android:textColor="@color/jarvis_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/btnClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLEAR"
                        android:textColor="@color/jarvis_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/scrollTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/tvTerminalOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="[JARVIS-X KERNEL READY]\nInitializing autonomous loop..."
                        android:textColor="@color/jarvis_text_secondary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
